{
  "manifest_version": 3,
  "name": "Ask This Video",
  "short_name": "Ask This Video",
  "version": "1.0.0",
  "description": "Chat with any YouTube video. Ask questions and get answers from its transcript, with timestamps you can click.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://youtubeqnaplugin.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["config.js", "rag.js", "transcript.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
